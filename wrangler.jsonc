// Cloudflare Workers config for the static frontend (Workers Builds runs
// `npm run build` then `npx wrangler deploy`). Static asset requests are free.
// No secrets here. The /api Worker has its own config in worker/wrangler.toml.
{
  "name": "right-now",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
