// Cloudflare Worker for Right Now: the static site (Workers static assets)
// plus a small API under /api/* and two cron jobs (free plan allows 5).
// Workers Builds runs `npm run build`, then `npx wrangler deploy`.
//
// No secrets or account ids here:
// - the KV namespace has no id: Wrangler provisions it on first deploy;
// - NVD_API_KEY is a Worker secret (dashboard → Settings → Variables and
//   Secrets, or `npx wrangler secret put NVD_API_KEY`). Never commit it.
{
  "name": "right-now",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API requests run the Worker; everything else is a free asset hit.
    "run_worker_first": ["/api/*"],
  },
  "kv_namespaces": [{ "binding": "DATA" }],
  "triggers": {
    // NVD every 20 min; CISA KEV every 2 h (at :17 to avoid the top of the hour)
    "crons": ["*/20 * * * *", "17 */2 * * *"],
  },
  "observability": { "enabled": true },
}
