{
  "name": "right-now",
  "version": "1.0.0",
  "description": "A live, beautiful window on what is happening in the world right now.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "record:fixtures": "node scripts/record-fixtures.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdoardoRoba/right-now.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/EdoardoRoba/right-now/issues"
  },
  "homepage": "https://github.com/EdoardoRoba/right-now#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
